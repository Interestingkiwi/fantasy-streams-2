# Copy to .env and fill in real values. .env is git-ignored.

# --- Database (required) ---
# Local PostgreSQL used by the Flask app and the preseason_db_build pipeline.
DATABASE_URL=postgresql://postgres:password@localhost:5432/fantasystreams

# --- Flask ---
# APP_ENV: development (default) or production. In production FLASK_SECRET_KEY
# is required and cookies are marked Secure.
APP_ENV=development
# FLASK_DEBUG=1                # defaults on outside production
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Yahoo Fantasy OAuth (required for /login, Phase 1) ---
# From https://developer.yahoo.com/apps/ — register the app for read/write scope
# (scope is fixed at registration; Phase 4 needs writes).
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=

# Must match the Redirect URI registered with Yahoo character for character.
# Yahoo rejects plain http:// callbacks, so local dev needs an HTTPS tunnel
# (ngrok/cloudflared) pointed at :5000 — register the tunnel URL and set it
# here. Leave unset in a normal deploy: it is then built from the request.
# YAHOO_REDIRECT_URI=https://your-tunnel.example.com/callback

# Optional: "<league_id>-<this value>" in the login box bypasses Yahoo in dev,
# e.g. "12345-letmein". The only way to test signed-in pages without a tunnel.
# DEV_BACKDOOR_PASS=

# --- Background jobs (Phase 2+) ---
# Leave unset locally to run league sync inline; set it to use a Redis/RQ worker.
REDIS_URL=

# --- Optional: one-off prod snapshot script (preseason_db_build is unaffected) ---
# Only needed if running the local, git-ignored export_postgres.py against the
# old Render database. Use Render's *External* Database URL.
# RENDER_DATABASE_URL=
